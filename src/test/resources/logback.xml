<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Generate unique timestamp for log file name -->
    <timestamp key="bySecond" datePattern="yyyyMMdd'T'HHmmss"/>

    <!-- Set default test suite name (used when running from IDE without -D parameter) -->
    <property name="testSuite" value="default"/>

    <!-- Console appender with formatted output -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender with unique name: test suite + timestamp -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/test-logs/${testSuite}-${bySecond}.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logging level: INFO for general flow, DEBUG for troubleshooting -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
</configuration>