<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Test Suite" parallel="classes" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="All Tests">
        <classes>
            <class name="com.framework.tests.CheckboxesTest"/>
            <class name="com.framework.tests.InputsTest"/>
            <class name="com.framework.tests.DropdownTest"/>
            <class name="com.framework.tests.AddRemoveTest"/>
            <class name="com.framework.tests.NotificationMessagesTest"/>
        </classes>
    </test>
</suite>